# Commonly used programs
alias open="xdg-open" 			# Generic open
alias view="nvim -M"        # Very strict RO
alias chrome="google-chrome-beta"	# Web browser
alias fetch="fastfetch"
alias tbmsg="cd $TBMSG_HOME && ./res-modules/block-mining-simulation-game-single-player-client/run_single_player_client.sh; cd -"
alias codex="codex --dangerously-bypass-approvals-and-sandbox"

# Custom help and usage information (generated by cligpt)
alias rghelp='echo $RG_HELP'
alias fzfhelp='echo $FZF_HELP'
alias awkhelp='echo $AWK_HELP'
alias sedhelp='echo $SED_HELP'

# cliGPT aliases
alias gotogpt="cd $GPT_HOME;clear;ls -al;git pull;"
alias gpt-todo="cd $GPT_HOME; git pull; $EDITOR $GPT_HOME/todo.md; git add .; git commit -m 'Edit cligpt todo items'; git push; cd -"
alias gpt-repeat="tail -n 50 $GPT_HOME/context.txt"
alias gpt-context="view $GPT_HOME/context.txt"

# General files: Edit and push to github
alias todo="cd ~/github/notes; git pull; $EDITOR ~/todo.md; git add .; git commit -m 'Edit todo items'; git push; cd -"

# .zsh files: pull, edit, and push to GitHub
#
# These were aliases joined with semicolons, so a failed `git pull` still
# opened the editor and committed whatever happened to be staged. Keep the
# convenience commands, but stop immediately on a Git/editor failure and only
# commit the file that was edited.
unalias rc zshrc aliases exports func 2>/dev/null

_dotfiles_edit() {
  local dotfiles_dir="$HOME/github/dotfiles"
  local file="$1"
  local message="$2"
  local editor="${EDITOR:-nvim}"

  if [[ ! -d "$dotfiles_dir/.git" ]]; then
    print -u2 -- "Dotfiles repository not found: $dotfiles_dir"
    return 1
  fi

  # Autostash lets these commands publish an edit that was made before the
  # helper was run, without failing because the working tree is dirty.
  git -C "$dotfiles_dir" pull --rebase --autostash || return
  "$editor" "$dotfiles_dir/$file" || return

  git -C "$dotfiles_dir" add -- "$file" || return
  if git -C "$dotfiles_dir" diff --cached --quiet -- "$file"; then
    print -- "No changes to $file."
    return 0
  fi

  # --only prevents unrelated staged dotfile changes from being included.
  git -C "$dotfiles_dir" commit --only -m "$message" -- "$file" || return
  git -C "$dotfiles_dir" push
}

zshrc() { _dotfiles_edit .zshrc 'Edit .zshrc'; }
rc() { zshrc; }
aliases() { _dotfiles_edit .zsh_aliases 'Edit .zsh_aliases'; }
exports() { _dotfiles_edit .zsh_exports 'Edit .zsh_exports'; }
func() { _dotfiles_edit .zsh_functions 'Edit .zsh_functions'; }

alias secrets="$EDITOR ~/.zsh_secrets"
alias zreload="source ~/.zshrc"

# File and Directory Management
alias cls='clear'	 	# Clear the terminal (Windows-style)
alias cfetch='clear; fastfetch;'
alias cf='cfetch'
alias cl='clear; ls'		# Clear and list short
alias cll='clear; ll'		# Clear and list long
alias cla='clear; la'		# Clear and list all
alias l='ls -F'			# Compact list with file types
alias llr='ls -alRF'		# Detailed recursive file list
alias ..='cd ..'		# Go up one directory
alias ...='cd ../..'		# Go up two directories
alias mkd='mkdir -p'		# Create a directory and its parents
alias rmd='rm -r'		# Remove directories recursively

# System Monitoring and Management
alias dfh='df -h'           # Disk usage in human-readable format
alias duh='du -h'           # Directory size in human-readable format
alias free='free -m'        # Memory usage in MB
alias top='htop'            # Use htop instead of top
alias pstree='ps auxf'      # Process tree
alias reload='source ~/.zshrc' # Reload zsh configuration

# Git Workflow
alias gs='git status'       # Show git status
alias ga='git add'          # Add files to staging
alias gc='git commit -m'    # Commit with a message
alias gp='git push'         # Push changes
alias gpl='git pull'        # Pull changes
alias gl='git log --oneline --graph --decorate' # Git log visualization

# Networking
alias ports='netstat -tulanp' # Show listening ports
alias ping='ping -c 3'        # Ping 5 times
alias wget='wget -c'          # Resume downloads with wget
alias speedtest='curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python -' # Run speedtest

# Development Utilities
alias venv='python -m venv .venv'     # Shortcut for creating virtual environments
alias activate='source .venv/bin/activate' # Activate the current venv
alias live-server='npm live-server .' 

# Other / General Purpose
alias grep='grep --color=auto'		# Highlight matches in grep
alias hist='history'			# Show command history
alias backup='tar -czvf backup.tar.gz'	# Create compressed backups
